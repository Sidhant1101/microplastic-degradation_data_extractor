# ---------------------------------------------------------------------------
# Microplastic Degradation Research Data Extractor AI - environment settings
# Copy to .env and adjust:   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Web ---------------------------------------------------------------------
FRONTEND_PORT=3000
# Use 127.0.0.1 to keep the app private to this machine
FRONTEND_BIND=0.0.0.0
# Origins allowed to call the API directly (comma-separated)
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) -----------------------------------------------------
POSTGRES_USER=mpai
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=mpai

# --- LLM (Ollama) ---------------------------------------------------------------
LLM_PROVIDER=ollama
# Any model installed in Ollama. Larger instruction-tuned models extract far better.
# Examples: llama3.1 (8B), qwen2.5:7b, qwen2.5:14b, mistral-nemo, llama3.3:70b
OLLAMA_MODEL=llama3.1
# Seconds to wait for one model response (CPU-only servers need several minutes)
OLLAMA_TIMEOUT=600
# Context window in tokens; must hold prompt + one chunk + the answer
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_IMAGE_TAG=latest
LLM_MAX_RETRIES=2

# --- Extraction pipeline -------------------------------------------------------
# Characters per chunk sent to the model, and characters shared between chunks
CHUNK_SIZE=6000
CHUNK_OVERLAP=600
# Hard cap on chunks per paper (the most relevant chunks are kept)
MAX_CHUNKS=24
MAX_EXPERIMENTS_PER_PAPER=30
# Second-stage LLM review of every experiment
VALIDATION_LLM_ENABLED=true
EXTRACTION_TIMEOUT_SECONDS=3600
WORKER_CONCURRENCY=1

# --- Documents ---------------------------------------------------------------------
MAX_UPLOAD_MB=50
OCR_ENABLED=true
OCR_LANGUAGE=eng
# auto | pdfplumber | camelot | none
TABLE_EXTRACTOR=auto

# --- DOI / metadata ---------------------------------------------------------------
# Your e-mail: used in the polite User-Agent for Crossref/OpenAlex and REQUIRED by
# Unpaywall to find legal open-access PDFs. Leave empty to skip Unpaywall.
CONTACT_EMAIL=
METADATA_LOOKUP_ENABLED=true

# --- Security ---------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# --- Logging ------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
API_WORKERS=2

# --- Production (docker-compose.prod.yml) ------------------------------------------
# Public domain served by Caddy with automatic HTTPS
DOMAIN=
# E-mail for the certificate authorities (Let's Encrypt, ZeroSSL fallback); required
ACME_EMAIL=
OLLAMA_MEMORY_LIMIT=16G
BACKUP_KEEP_DAYS=14
